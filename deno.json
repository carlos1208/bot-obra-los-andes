{
  "tasks": {
    "test": "deno test --allow-read --allow-env tests/",
    "check": "deno check supabase/functions/telegram/index.ts supabase/functions/programado/index.ts supabase/functions/tablero/index.ts scripts/*.ts tests/*.ts",
    "ids": "deno run --allow-net --allow-read --allow-env scripts/telegram_ids.ts",
    "cuenta-servicio": "deno run --allow-read --allow-write --allow-env scripts/service_account.ts",
    "oauth-drive": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run scripts/drive_oauth.ts",
    "crear-hoja": "deno run --allow-net --allow-read --allow-env scripts/crear_hoja.ts",
    "webhook": "deno run --allow-net --allow-read --allow-env scripts/set_webhook.ts",
    "secreto": "deno run --allow-read --allow-write --allow-env scripts/webhook_secret.ts",
    "secreto-programado": "deno run --allow-read --allow-write --allow-env scripts/webhook_secret.ts PROGRAMADO_SECRET",
    "secreto-correo": "deno run --allow-read --allow-write --allow-env scripts/webhook_secret.ts GMAIL_SCRIPT_SECRET",
    "secreto-tablero": "deno run --allow-read --allow-write --allow-env scripts/webhook_secret.ts TABLERO_TOKEN_CARLOS TABLERO_TOKEN_HERMANO",
    "revisar": "deno run --allow-read --allow-env scripts/check_env.ts",
    "secretos": "deno run --allow-read --allow-write --allow-env --allow-run scripts/push_secrets.ts",
    "validar-ia": "deno run --allow-net --allow-read --allow-env scripts/validate_ai.ts",
    "programado": "deno run --allow-net --allow-read --allow-env scripts/programado.ts",
    "catalogo": "deno eval \"Deno.copyFileSync('semillas/fotos_antes.json', 'supabase/functions/_shared/fotos_antes.json')\""
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-import-prefix"
      ]
    }
  }
}
