# Copia este archivo a .env.local y llénalo. .env.local NO se sube a git.
# Para mandarlos a Supabase: deno task secretos (sube solo los que tienen valor)

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CARLOS_TG_ID=
HERMANO_TG_ID=
GROUP_CHAT_ID=
TOPIC_REPORTES_ID=
TOPIC_FOTOS_ID=
TOPIC_GASTOS_ID=

# Google Sheets (cuenta de servicio)
SHEET_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# Google Drive (OAuth con la cuenta de Carlos)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=

# Gemini (fase 2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.6-flash

# Avisos programados (fase 6): deno task secreto-programado. El mismo valor va en Vault (programado_secreto)
PROGRAMADO_SECRET=

# Facturas del correo (/correo): URL de la app web del Apps Script y su secreto (deno task secreto-correo)
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=

# Tablero (/tablero): URL /exec del Apps Script del tablero y el código del enlace de cada uno
# (deno task secreto-tablero). Cambiar un código deja sin servir el enlace viejo.
TABLERO_URL=
TABLERO_TOKEN_CARLOS=
TABLERO_TOKEN_HERMANO=

# Solo para los scripts locales (no es secreto; la CLI de Supabase lo ignora)
PROJECT_REF=
